{
    "name": "arturkos/gallery",
    "description": "PHP web image gallery with BCrypt authentication, per-user file isolation, and inline media playback.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "friendsofphp/php-cs-fixer": "^3.50",
        "phpstan/phpstan": "^1.10"
    },
    "autoload": {
        "psr-4": {
            "ArturKos\\Gallery\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ArturKos\\Gallery\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "lint": "php-cs-fixer fix --dry-run --diff",
        "fix": "php-cs-fixer fix",
        "analyse": "phpstan analyse"
    },
    "config": {
        "sort-packages": true
    }
}
